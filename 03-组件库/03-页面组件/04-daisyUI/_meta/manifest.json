  "categories": {
    "按钮": "Button",
    "表单": "Fieldset/Label/Input/Textarea/Select/Checkbox/Radio/Toggle/Range/Rating/FileInput/Validator/OTP/Calendar",
    "导航": "Menu/Navbar/Tab/Breadcrumbs/Steps/Pagination(join)/Join/Drawer/Dock/Footer/Megamenu/Filter",
    "浮层": "Modal/Dropdown/Tooltip/Toast/FAB/Alert/Swap",
    "展示": "Card/Table/Stat/Badge/Avatar/Status/Progress/RadialProgress/Loading/Skeleton/Timeline/List/Collapse(Accordion)/Carousel/Chat/Diff/Stack/Mask/Indicator/Countdown",
    "展示道具": "MockupBrowser/MockupWindow/MockupPhone/MockupCode",
    "基础": "Kbd/Divider/Link/Hero/ThemeController/TextRotate/Aura/Hover3D/HoverGallery"
  },
  "consumption": {
    "default": "link-css-then-classes",
    "rules": [
      "把 dist/daisyui-lite.css（或 daisyui.css）放进工程样式目录，<link> 或 @import 引入一次",
      "工程必须已是 Tailwind CSS 4；daisyUI 5 不支持 Tailwind 3 的 tailwind.config.js 写法",
      "先用语义类名（btn / card / table），不够再用 Tailwind 工具类补齐（btn px-10）",
      "全局改组件样式用 @utility，单点覆盖用工具类加 !，不要写裸 CSS 选择器覆盖",
      "业务列表 / 审批 / 订单 / CMS 类页面仍用 Codebuddy Design 的 React 组件，不要用 daisyUI 的 table 重造"
    ]
  },
  "build": {
    "install": "npm install",
    "full": "npx tailwindcss -i ./src/input.css -o ./dist/daisyui.css --minify",
    "lite": "npx tailwindcss -i ./src/input-lite.css -o ./dist/daisyui-lite.css --minify",
    "preview": "node _meta/build-preview.mjs"
  },
  "size": {
