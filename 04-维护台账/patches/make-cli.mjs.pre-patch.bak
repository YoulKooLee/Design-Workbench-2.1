  };
}
async function waitForDesktopClientExit({
  isRunning,
  wait,
  maxAttempts,
  retryDelayMs
}) {
  for (let attempt = 0;attempt < maxAttempts; attempt += 1) {
    if (!await isRunning())
      return true;
    if (attempt + 1 < maxAttempts)
      await wait(retryDelayMs);
  }
  return false;
}

// src/server/agentSurfaceIntegration.ts
var MAKE_AGENT_SURFACE_HOSTS = {
  chatgpt: "codex",
  cursor: "cursor",
  workbuddy: "workbuddy",
  traework: "traework"
