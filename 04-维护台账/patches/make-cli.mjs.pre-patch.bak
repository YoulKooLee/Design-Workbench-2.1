      return true;
    }
    if (!snapshot.hasCanvasFig) {
      sendJson(res, {
        error: "当前页面尚未生成 .fig 导出所需资产，请先复制 Prompt 让 AI 补齐。",
        code: "FIGMA_MAKE_ASSETS_REQUIRED",
        projectId: context.project.id,
        projectRoot: context.project.root,
        path: targetPath,
