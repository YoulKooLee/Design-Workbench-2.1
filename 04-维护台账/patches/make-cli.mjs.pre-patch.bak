    webBaseUrl: normalizeBaseUrl3(process.env.AXHUB_ASSISTANT_WEB_BASE_URL),
    apiBaseUrl: normalizeBaseUrl3(process.env.AXHUB_ASSISTANT_API_BASE_URL)
  };
