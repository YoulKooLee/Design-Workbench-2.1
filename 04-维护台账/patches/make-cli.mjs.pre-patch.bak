    }).catch((error) => sendJson(res, { error: error?.message || "Invalid JSON body" }, { status: 400 }));
    return true;
  }
  sendJson(res, { error: "Method not allowed", code: "METHOD_NOT_ALLOWED" }, { status: 405 });
  return true;
}

