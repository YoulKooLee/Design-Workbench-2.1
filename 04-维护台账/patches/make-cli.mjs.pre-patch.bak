    error: `${capability} requires project-side export capability or source metadata`,
    code: "ADAPTER_REQUIRED",
    projectId: context.project.id,
    projectRoot: context.project.root,
    path: targetPath,
    adapterRequired: true
  };
}
function createBuildArtifactRequiredPayload(context, targetPath, details = {}) {
  return {
    error: "Runtime build artifact is required to export the runtime bundle",
    code: "BUILD_ARTIFACT_REQUIRED",
    projectId: context.project.id,
    projectRoot: context.project.root,
    path: targetPath,
    resourceId: String(details.resourceId || ""),
    sourceRequired: true,
    adapterRequired: true,
    details
  };
}
function createSourceMetadataRequiredPayload(context, targetPath, details = {}) {
