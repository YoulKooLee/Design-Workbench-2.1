    console.error("[导出 HTML] ZIP error:", error);
    if (!res.headersSent) {
      res.statusCode = 500;
      res.setHeader("Content-Type", "application/json; charset=utf-8");
      res.end(JSON.stringify({ error: `ZIP 创建失败: ${error.message}` }));
