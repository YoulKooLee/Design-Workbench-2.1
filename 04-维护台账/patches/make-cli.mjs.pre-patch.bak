    webBaseUrl,
    apiBaseUrl,
    projectId: params.projectId,
    projectRoot: params.projectRoot,
    runtime: {
      available: params.runtime.health.status === "ready",
      ...params.runtime.health.status === "ready" ? {} : { code: "assistant-runtime-unavailable" }
    }
  };
}

