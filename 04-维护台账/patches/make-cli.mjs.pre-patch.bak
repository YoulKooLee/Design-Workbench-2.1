}
function extractRecordList(body, singularKey, pluralKey) {
  if (!hasRecord(body))
    return [];
  const singular = body[singularKey];
  const plural = body[pluralKey];
  if (Array.isArray(plural))
    return plural;
  if (singular !== undefined)
    return [singular];
  return [];
}
