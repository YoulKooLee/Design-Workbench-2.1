var NPM_OFFICIAL_REGISTRY = {
  id: "npmjs",
  label: "npm official",
  url: "https://registry.npmjs.org"
};
var NPM_MIRROR_REGISTRY = {
  id: "npmmirror",
  label: "npmmirror",
  url: "https://registry.npmmirror.com"
};
var PUBLIC_NPM_REGISTRIES = [NPM_OFFICIAL_REGISTRY, NPM_MIRROR_REGISTRY];
var DEFAULT_PROBE_TIMEOUT_MS = 2000;
var DEFAULT_CONFIG_TIMEOUT_MS = 5000;
var CLOSE_TO_OFFICIAL_THRESHOLD_MS = 150;
function stringValue3(value) {
  return typeof value === "string" ? value.trim() : "";
}
function normalizedRegistryUrl(value) {
