  const sourceDirRelative = snapshot.sourceDir ? toPosix(path57.relative(snapshot.projectRoot, sourceDir)) : snapshot.artifactRootRelativePath;
  const relativeCanvasFig = toPosix(path57.relative(snapshot.projectRoot, snapshot.canvasFigPath));
  const relativeMeta = toPosix(path57.relative(snapshot.projectRoot, snapshot.metaJsonPath));
  const relativeManifest = toPosix(path57.relative(snapshot.projectRoot, snapshot.codeManifestPath));
  const relativeAiChat = toPosix(path57.relative(snapshot.projectRoot, snapshot.aiChatPath));
  const relativeImagesDir = toPosix(path57.relative(snapshot.projectRoot, snapshot.imagesDir));
