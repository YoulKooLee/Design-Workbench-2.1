  }
  if (explicitRegistry.registry) {
    return { mode: "configured", probes: [], reason: "npm-configured" };
  }
  const probeRegistry = options.probeRegistry || ((registry, packages, timeoutMs) => probeNpmRegistry(registry, packages, { timeoutMs }));
