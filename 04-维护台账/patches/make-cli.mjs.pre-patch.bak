  const dependencies = record2.dependencies && typeof record2.dependencies === "object" && !Array.isArray(record2.dependencies) ? record2.dependencies : {};
  const devDependencies = record2.devDependencies && typeof record2.devDependencies === "object" && !Array.isArray(record2.devDependencies) ? record2.devDependencies : {};
