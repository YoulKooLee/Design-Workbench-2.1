  if (!hasRecord(body))
    return [];
  const ids = new Set;
  for (const key of singularKeys) {
    const id = safeText(body[key]);
    if (id)
      ids.add(id);
  }
  for (const key of pluralKeys) {
    const value = body[key];
    if (!Array.isArray(value))
