      const builtCode = includeImageAssets ? rawBuiltCode : replaceEmbeddedImageAssets(rawBuiltCode);
      const axureCode = wrapSourceAsAxureExportCode(builtCode);
      sendJson(res, {
        entry: {
          name: String(resource?.name || resource?.id || path58.basename(path58.dirname(runtimeBuiltJsPath))),
          group: targetPath.split("/")[0] || "prototypes",
          displayName: String(resource?.title || resource?.name || resource?.id || path58.basename(path58.dirname(runtimeBuiltJsPath))),
          code: builtCode,
          axureCode,
          axureCodePath
        },
        meta: {
          version: 1,
          exportedAt: new Date().toISOString(),
          source: "runtime-built-js"
        },
        projectId: context.project.id
      });
      return true;
    }
    const missingArtifactDetails = {
      resourceId: String(resource?.id || resource?.name || ""),
      builtJsPath: runtimeBuiltJsRelativePath || undefined
    };
    handlers.sendDisabledCapability(res, 424, runtimeBuiltJsRelativePath ? createBuildArtifactRequiredPayload(context, targetPath, missingArtifactDetails) : createSourceMetadataRequiredPayload(context, targetPath, missingArtifactDetails));
    return true;
  }
  if (pathname === "/api/axure-export-code" && req.method === "GET") {
    if (sourceFile) {
      try {
        const buildResult = await buildOnDemand(context.project.root, sourceFile, { includeImageAssets });
        const cssInjection = buildResult.cssText.trim() ? `(function(){if(typeof document==='undefined')return;var s=document.createElement('style');s.textContent=${JSON.stringify(buildResult.cssText)};document.head.appendChild(s)})();
` : "";
        const executableCode = `${cssInjection}${buildResult.jsCode}${buildComponentBridgeSnippet()}`;
        sendText(res, executableCode, "text/javascript; charset=utf-8");
      } catch (buildError) {
        sendJson(res, {
          error: `On-demand build failed: ${buildError?.message || "unknown error"}`,
          code: "BUILD_FAILED",
          projectId: context.project.id,
          projectRoot: context.project.root,
          path: targetPath
        }, { status: 500 });
      }
      return true;
    }
    if (runtimeBuiltJsPath) {
      const rawBuiltCode = fs51.readFileSync(runtimeBuiltJsPath, "utf8");
      const builtCode = includeImageAssets ? rawBuiltCode : replaceEmbeddedImageAssets(rawBuiltCode);
      const executableCode = wrapSourceAsAxureExportCode(builtCode);
      sendText(res, executableCode, "text/javascript; charset=utf-8");
      return true;
