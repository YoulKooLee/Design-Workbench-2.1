  try {
    originalContent = fs5.readFileSync(filePath);
  } catch (error) {
    return createMakeStateHealthFailure({
      stateDir,
      registryPath,
      stage: "state-file-overwrite",
      targetPath: filePath,
      error
    });
  }
  try {
    const probe = {
      axhubMakeHealthCheck: true,
      fileName: path6.basename(filePath),
      checkedAt: new Date(0).toISOString()
    };
    fs5.writeFileSync(filePath, `${JSON.stringify(probe, null, 2)}
`, "utf8");
    fs5.writeFileSync(filePath, originalContent);
    return null;
  } catch (error) {
    try {
      fs5.writeFileSync(filePath, originalContent);
