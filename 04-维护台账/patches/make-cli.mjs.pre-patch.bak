    provider: input.provider,
    status: "opened",
    mode: "integrated",
    ...launch,
    ...operation
  };
}

// src/server/desktopClientLifecycle.ts
function buildDesktopClientGracefulQuit(provider, platform2, appPath) {
  if (platform2 === "darwin") {
    const applicationNames = {
      cursor: "Cursor",
      opencode: "OpenCode",
      workbuddy: "WorkBuddy",
      qoderwork: "QoderWork"
    };
    if (provider === "chatgpt") {
      return { command: "osascript", args: ["-e", 'tell application id "com.openai.codex" to quit'] };
    }
    const traeworkApplicationName = appPath?.match(/\/([^/]+)\.app(?:\/|$)/u)?.[1] || "TRAE SOLO";
    const applicationName = provider === "traework" ? traeworkApplicationName : applicationNames[provider];
    return { command: "osascript", args: ["-e", `tell application "${applicationName}" to quit`] };
  }
  const processNames = {
    chatgpt: "'ChatGPT','Codex'",
    cursor: "'Cursor'",
    opencode: "'OpenCode'",
    workbuddy: "'WorkBuddy'",
    traework: "'TRAE SOLO','TRAE SOLO CN'",
    qoderwork: "'QoderWork','QoderWork CN'"
  };
  return {
    command: "powershell.exe",
    args: [
      "-NoProfile",
      "-NonInteractive",
      "-Command",
      `$items = Get-Process -Name ${processNames[provider]} -ErrorAction SilentlyContinue; $items | ForEach-Object { $_.CloseMainWindow() | Out-Null }`
