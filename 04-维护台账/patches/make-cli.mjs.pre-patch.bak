  prompt += `请先阅读以下技能文档：
`;
  prompt += `- https://github.com/lintendo/Axhub-Skills/blob/main/skills/react-to-figma-make/SKILL.md

`;
  prompt += `目标源码目录：\`${sourceDirRelative || "."}/\`
`;
  prompt += `目标产物目录：\`${snapshot.artifactRootRelativePath}/\`
`;
  prompt += `当前判定：${sceneLabel}
`;
  prompt += `最终产物说明：接口最终下载的是原始 \`canvas.fig\`，文件名为 \`${snapshot.fileName}\`。

`;
  prompt += `当前资产状态：
`;
  prompt += `- canvas.fig：${snapshot.hasCanvasFig ? "已存在" : "缺失"}
`;
  prompt += `- meta.json：${snapshot.hasMetaJson ? "已存在" : "缺失"}
`;
  prompt += `- ai_chat.json：${snapshot.hasAiChat ? "已存在" : "缺失"}
`;
  prompt += `- canvas.code-manifest.json：${snapshot.hasManifest ? "已存在" : "缺失"}
`;
  prompt += `- manifest.json：${snapshot.hasArtifactManifest ? "已存在" : "缺失"}
`;
  prompt += `- images/：${snapshot.hasImagesDir ? `已存在（${snapshot.imageCount} 个文件）` : "缺失"}

`;
  if (snapshot.hasDriftRisk) {
    prompt += `当前检测到导出壳子可能未同步：
`;
    snapshot.driftReasons.forEach((reason) => {
      prompt += `- ${reason}
`;
    });
    prompt += `
`;
  }
