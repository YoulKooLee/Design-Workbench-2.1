async function handlePrototypeMakeUpload(res, options, context, parts, handlers) {
  const targetBaseDir = handlers.getDeclaredResourceWriteDir(context, "prototypes");
  if (!targetBaseDir) {
    sendUploadAdapterRequired(res, context, handlers);
    return;
  }
  const uploadMode = getMultipartTextField2(parts, "uploadMode") || "zip";
  const tempRoot = path71.join(context.project.root, "temp", "uploads");
  const tempDir = path71.join(tempRoot, `make-${Date.now()}-${randomUUID6()}`);
  let fallbackName = getMultipartTextField2(parts, "folderName") || "prototype";
  try {
    const targetPrototypeName = resolveUploadTargetPrototypeName(context, targetBaseDir, getMultipartTextField2(parts, "targetPrototypeName"));
    let forcedFolderName = targetPrototypeName;
    fs63.mkdirSync(tempDir, { recursive: true });
    if (uploadMode === "folder") {
      const folderResult = writeFolderUploadToTemp(parts, tempDir);
      fallbackName = folderResult.rootFolderName || fallbackName;
    } else {
      const filePart = getPrimaryMultipartFile2(parts);
