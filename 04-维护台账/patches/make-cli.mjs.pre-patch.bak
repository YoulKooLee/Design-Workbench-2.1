`;
  prompt += `1. 不要删除已有业务源码，也不要删除任何已存在的 Figma 原始资产。
`;
  prompt += `2. 产物必须写入 \`${snapshot.artifactRootRelativePath}/\`，其中 \`canvas.fig\` 路径为 \`${relativeCanvasFig}\`。
`;
  prompt += `3. 生成或更新 \`${relativeMeta}\`，至少包含 \`file_name\`、\`exported_at\`、\`client_meta\`、\`developer_related_links\`。
`;
  prompt += `4. 确保 \`${relativeAiChat}\` 至少是空 JSON 对象 \`{}\`。
`;
  prompt += `5. 生成或更新 \`${relativeManifest}\`：
`;
  prompt += `   \`node scripts/canvas-fig-sync.mjs inspect --fig ${relativeCanvasFig} --manifest ${relativeManifest}\`
`;
  prompt += `6. 如页面依赖图片资源，请把导出所需图片保留或同步到 \`${relativeImagesDir}/\`。

`;
  prompt += `验收要求：
`;
  prompt += `- \`node scripts/canvas-fig-sync.mjs inspect --fig ${relativeCanvasFig}\` 能成功执行
`;
  prompt += `- \`${relativeMeta}\` 中 \`file_name\` 对应最终下载文件名 \`${snapshot.fileName}\`
`;
  prompt += `- 再次访问 \`/api/export-make?path=${snapshot.path}&probe=1\` 时，返回 \`hasMakeAssets: true\`
`;
  return prompt;
}
function hasFigmaMakeArtifactCapability(projectRoot, metadata) {
  return metadata.resources.prototypes.some((resource) => {
    const figma = getFigmaArtifactConfig(resource);
    const explicitCanvas = resolveProjectFile(projectRoot, figma.canvasFigPath);
    if (explicitCanvas) {
      return true;
    }
    const resourceId = getResourceId(resource, resource.id || resource.name);
    if (fs50.existsSync(path57.join(projectRoot, FIGMA_ARTIFACT_ROOT_RELATIVE, resourceId, "canvas.fig"))) {
      return true;
    }
    const sourceFile = resolveProjectPathForArtifact(projectRoot, resource.absoluteFilePath || resource.filePath);
    if (sourceFile && fs50.existsSync(path57.join(path57.dirname(sourceFile), "canvas.fig"))) {
      return true;
    }
    return false;
  });
}

