}
function chooseNpmRegistry(probes, closeThresholdMs = CLOSE_TO_OFFICIAL_THRESHOLD_MS) {
  const successful = probes.filter((probe) => probe.ok).sort((left, right) => left.durationMs - right.durationMs);
  if (successful.length === 0) {
    return {
      alternate: NPM_MIRROR_REGISTRY,
