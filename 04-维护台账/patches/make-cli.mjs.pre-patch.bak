}
function verifyDirectoryWritable(stateDir, registryPath) {
  const probePath = path6.join(stateDir, `.projects.json.health-${process.pid}-${Date.now()}`);
  const tempPath = `${probePath}.tmp`;
  const finalPath = `${probePath}.ok`;
  try {
    fs5.writeFileSync(tempPath, `{}
`, "utf8");
    fs5.renameSync(tempPath, finalPath);
    fs5.unlinkSync(finalPath);
    return null;
  } catch (error) {
    return createMakeStateHealthFailure({
      stateDir,
      registryPath,
      stage: "state-dir-write",
      targetPath: stateDir,
      error
    });
  } finally {
    for (const filePath of [tempPath, finalPath]) {
