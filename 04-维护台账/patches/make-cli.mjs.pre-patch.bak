    schemaVersion: 1,
    entries: [{
      id: "axhub-make",
      name: "Axhub Make",
      icon: { type: "data-url", value: AXHUB_MAKE_ICON_DATA_URL },
      hosts: ["codex", "cursor", "workbuddy", "traework"],
      url: pageUrl.toString(),
