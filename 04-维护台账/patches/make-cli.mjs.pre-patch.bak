    const resolvedOutputPath = path18.resolve(explicitOutputPath);
    if (params.total === 1 && path18.extname(resolvedOutputPath)) {
      return resolvedOutputPath;
    }
    const outputDir2 = path18.extname(resolvedOutputPath) ? path18.dirname(resolvedOutputPath) : resolvedOutputPath;
    const baseName = path18.extname(resolvedOutputPath) ? path18.basename(resolvedOutputPath, path18.extname(resolvedOutputPath)) : "preview-capture";
    return path18.join(outputDir2, `${sanitizeFileName(baseName)}-${buildScreenshotFileSuffix(params.screenshot, params.index)}.${params.extension}`);
  }
  const outputDir = path18.resolve(params.outputOptions.outputDir || params.options.captureOutputRoot || getDefaultCaptureOutputRoot());
  return path18.join(outputDir, `${buildCaptureFilePrefix()}-${buildScreenshotFileSuffix(params.screenshot, params.index)}.${params.extension}`);
