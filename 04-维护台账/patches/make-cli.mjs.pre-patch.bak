      const artifactUpdated = Number.isFinite(artifactMtimeMs) && artifactMtimeMs > Number(session.artifactMtimeMs || 0) + 1;
      const stale = Boolean(currentDescriptor2 && currentDescriptor2.sourceHash !== session.sourceHash);
