      try {
        client.socket.write(frame);
      } catch {
        this.removeClient(client.id, "write-error");
      }
    }
  }
  broadcastStatus() {
    this.broadcastImmediate(this.buildStatusMessage());
  }
  buildStatusMessage() {
    let adminCount = 0;
    let opencodeCount = 0;
    for (const client of this.clients.values()) {
      if (client.role === "admin")
        adminCount++;
      else if (client.role === "opencode")
