import fs5 from "node:fs";
import path6 from "node:path";
var MAKE_STATE_DIR_NOT_WRITABLE = "MAKE_STATE_DIR_NOT_WRITABLE";
var MAKE_STATE_NOT_WRITABLE_MESSAGE = "Axhub Make 无法保存本机项目列表";
function resolveRegistryPath(options = {}) {
