}
function readExportRecords(projectRoot) {
  const exportsDir = getProjectExportsDir(projectRoot);
  if (!fs42.existsSync(exportsDir)) {
    return [];
  }
  return fs42.readdirSync(exportsDir).filter((fileName) => fileName.endsWith(".json")).flatMap((fileName) => {
    try {
      const parsed = JSON.parse(fs42.readFileSync(path49.join(exportsDir, fileName), "utf8"));
      return parsed && typeof parsed === "object" ? [parsed] : [];
    } catch {
