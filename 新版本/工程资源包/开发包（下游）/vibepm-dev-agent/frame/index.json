{
  "version": "1.0.0",
  "description": "共享原型母版登记表。模板目录挂在 frame/ 根下；端别与默认库由 ends 映射。供 Agent / 维护者选型；feature-dev 对照母版在交付子项目（admin/、web/）用 Vue SFC 重写，不复制 HTML runtime。本包不交付 APP 母版。",
  "ends": {
    "admin": {
      "outputDir": "admin",
      "defaultFramework": "admin",
      "frameworks": {
        "admin": {
          "path": "admin",
          "theme": "arco",
          "capability": "full-runtime",
          "label": "管理后台 · Vibe Design Pro",
          "status": "ready"
        }
      }
    },
    "web": {
      "outputDir": "web",
      "defaultFramework": "web",
      "frameworks": {
        "web": {
          "path": "web",
          "theme": "arco",
          "capability": "layouts-blocks-components",
          "label": "WEB · Arco HTML 母版（壳 / 区块 / 组件）",
          "status": "ready"
        }
      }
    }
  }
}
