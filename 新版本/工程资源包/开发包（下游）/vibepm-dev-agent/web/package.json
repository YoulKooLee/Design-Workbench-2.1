{
  "name": "vibepm-web",
  "private": true,
  "version": "1.0.0",
  "description": "Vibe Design WEB 业务交付工程（对照 frame/web）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type:check": "vue-tsc -b --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,vue,css,json,md}\"",
    "prepare": "node scripts/prepare-husky.mjs"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.59.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.9.0",
    "eslint-plugin-vue": "^9.27.0",
    "husky": "^9.1.0",
    "prettier": "^3.5.0",
    "sass": "^1.107.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.9.0",
    "vite": "^8.3.6",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.8.0"
  },
  "packageManager": "pnpm@9.15.0"
}
