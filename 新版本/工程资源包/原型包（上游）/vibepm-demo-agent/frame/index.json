{
  "version": "1.0.0",
  "description": "共享原型框架注册表。模板目录挂在 frame/ 根下；端别与默认库由 ends 映射。WEB 默认母版为 frame/web（壳 / 区块 / 组件）。含 admin / web / app。",
  "ends": {
    "admin": {
      "outputDir": "admin",
      "defaultFramework": "admin",
      "frameworks": {
        "admin": {
          "path": "admin",
          "theme": "arco",
          "capability": "full-runtime",
          "label": "管理后台 · Vibe Design Pro",
          "configFile": ".admin-config.json",
          "status": "ready"
        }
      }
    },
    "web": {
      "outputDir": "web",
      "defaultFramework": "web",
      "frameworks": {
        "web": {
          "path": "web",
          "theme": "arco",
          "capability": "layouts-blocks-components",
          "label": "WEB · Arco HTML 母版（壳 / 区块 / 组件）",
          "status": "ready"
        }
      }
    },
    "app": {
      "outputDir": "app",
      "defaultFramework": "app",
      "frameworks": {
        "app": {
          "path": "app",
          "capability": "shells-and-vendor",
          "label": "APP 设备壳资源包",
          "status": "ready"
        }
      }
    }
  }
}
